{
    "config": {
        "flow_title": "{name}",
        "step": {
            "connection": {
                "title": "Wattpilot charger",
                "description": "Choose how Home Assistant should connect to your Wattpilot charger.",
                "data": {
                    "connection": "Connection type"
                },
                "data_description": {
                    "connection": "Local connects directly over your LAN. Cloud connects through the go-e cloud using the charger serial number."
                }
            },
            "local": {
                "title": "Local connection",
                "description": "Enter the local network details of your Wattpilot charger.",
                "data": {
                    "friendly_name": "Name",
                    "ip_address": "IP address",
                    "password": "Password",
                    "timeout": "Timeout"
                },
                "data_description": {
                    "friendly_name": "Display name for the charger in Home Assistant.",
                    "ip_address": "Local IP address of the charger on your network.",
                    "password": "The local charger password configured in the Wattpilot app.",
                    "timeout": "Seconds to wait for the connection to be established and initialised."
                }
            },
            "cloud": {
                "title": "Cloud connection",
                "description": "Enter the go-e cloud details of your Wattpilot charger.",
                "data": {
                    "friendly_name": "Name",
                    "serial": "Serial number",
                    "password": "Password",
                    "timeout": "Timeout"
                },
                "data_description": {
                    "friendly_name": "Display name for the charger in Home Assistant.",
                    "serial": "Serial number of the charger, used to reach it through the go-e cloud.",
                    "password": "The cloud password configured for your charger.",
                    "timeout": "Seconds to wait for the connection to be established and initialised."
                }
            },
            "zeroconf_confirm": {
                "title": "Wattpilot charger",
                "description": "Set up the discovered Wattpilot charger \"{name}\".",
                "data": {
                    "password": "Password",
                    "timeout": "Timeout"
                },
                "data_description": {
                    "password": "The local charger password configured in the Wattpilot app.",
                    "timeout": "Seconds to wait for the connection to be established and initialised."
                }
            },
            "reauth_confirm": {
                "title": "Wattpilot charger",
                "description": "The password for \"{name}\" is no longer valid. Enter the current charger password.",
                "data": {
                    "password": "Password"
                },
                "data_description": {
                    "password": "The local charger password configured in the Wattpilot app."
                }
            },
            "reconfigure": {
                "title": "Wattpilot charger",
                "description": "Update the connection details for \"{name}\". The connection type cannot be changed here; add the charger again to switch between a local and a cloud connection.",
                "data": {
                    "friendly_name": "Name",
                    "ip_address": "IP address",
                    "password": "Password",
                    "serial": "Serial number",
                    "timeout": "Timeout"
                },
                "data_description": {
                    "friendly_name": "Display name for the charger in Home Assistant.",
                    "ip_address": "Local IP address of the charger on your network.",
                    "password": "The local charger password configured in the Wattpilot app.",
                    "serial": "Serial number of the charger, as shown in the Wattpilot app.",
                    "timeout": "Seconds to wait for the connection to be established and initialised."
                }
            }
        },
        "abort": {
            "already_configured": "This charger is already configured.",
            "exception": "An unexpected error occurred. Please check the logs for details.",
            "no_ipv4": "The discovered charger did not advertise an IPv4 address.",
            "no_serial": "The discovered device did not advertise a serial number.",
            "reauth_successful": "Reauthentication was successful.",
            "reconfigure_successful": "The charger connection details were updated.",
            "wrong_charger": "Those details belong to a different charger. Reconfiguration can only update how this charger is reached."
        },
        "error": {
            "cannot_connect": "Failed to connect to the charger. Please check it is online and try again.",
            "invalid_auth": "Invalid password. Please check the charger password and try again.",
            "wrong_charger": "Those details belong to a different charger. Reconfiguration can only update how this charger is reached."
        }
    },
    "selector": {
        "connection": {
            "options": {
                "local": "Local (LAN)",
                "cloud": "go-e Cloud"
            }
        },
        "day_type": {
            "options": {
                "weekdays": "Weekdays",
                "saturday": "Saturday",
                "sunday": "Sunday"
            }
        }
    },
    "services": {
        "set_next_trip": {
            "name": "Set next trip",
            "description": "Sets the departure time used by the Next Trip charging mode.",
            "fields": {
                "device_id": {
                    "name": "Charger",
                    "description": "Charger device to apply the change to."
                },
                "trigger_time": {
                    "name": "Next trip",
                    "description": "Time of the next trip departure."
                }
            }
        },
        "set_charging_schedule": {
            "name": "Set charging schedule",
            "description": "Writes one day type of the app's charging schedule (charging times) to the charger. Fields left empty keep their current value.",
            "fields": {
                "device_id": {
                    "name": "Charger",
                    "description": "Charger device to apply the change to."
                },
                "day_type": {
                    "name": "Day type",
                    "description": "Which schedule to change: weekdays, Saturday or Sunday."
                },
                "limit_charging_times": {
                    "name": "Limit charging times",
                    "description": "Only charge inside the charging times."
                },
                "pv_surplus_outside_times": {
                    "name": "PV surplus outside times",
                    "description": "Allow charging with PV surplus outside the charging times."
                },
                "ranges": {
                    "name": "Charging times",
                    "description": "The charging windows, as a list of begin/end times of day (HH:MM). Each window must end after it begins on the same day and windows must not overlap; a window over midnight is split into an evening and a morning one, as the app does."
                }
            }
        },
        "set_goe_cloud": {
            "name": "Set go-e cloud",
            "description": "Enables or disables go-e cloud access for the charger.",
            "fields": {
                "device_id": {
                    "name": "Charger",
                    "description": "Charger device to apply the change to."
                },
                "cloud_api": {
                    "name": "Cloud API",
                    "description": "Turn go-e cloud API access on or off."
                }
            }
        },
        "set_debug_properties": {
            "name": "Set debug properties",
            "description": "Enables or disables logging of charger property changes as warnings in the log.",
            "fields": {
                "device_id": {
                    "name": "Charger",
                    "description": "Charger device to apply the change to."
                },
                "debug_properties": {
                    "name": "Debug properties",
                    "description": "TRUE logs all property changes, FALSE logs none, or provide a list of property codes to log only those."
                }
            }
        },
        "disconnect_charger": {
            "name": "Disconnect charger",
            "description": "Disconnects an established charger connection. Entities become unavailable until reconnected.",
            "fields": {
                "device_id": {
                    "name": "Charger",
                    "description": "Charger device to apply the change to."
                }
            }
        },
        "reconnect_charger": {
            "name": "Reconnect charger",
            "description": "Re-establishes a disconnected charger connection.",
            "fields": {
                "device_id": {
                    "name": "Charger",
                    "description": "Charger device to apply the change to."
                }
            }
        }
    },
